branch="$(git symbolic-ref --short HEAD)"

# Accept: feature/*, fix/*, hotfix/*, main/dev
if ! echo "$branch" | grep -Eq '^(feature|fix|hotfix|chore|backup)\/[a-z0-9._-]+$|^(main|dev)$'; then
  echo "❌ Invalid branch name: '$branch'"
  echo "✅ Use: feature/*, fix/*, hotfix/*, chore/*, backup/* main, or dev"
  exit 1
fi

pnpm typecheck
pnpm test
