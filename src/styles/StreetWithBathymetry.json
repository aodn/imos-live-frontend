{
  "version": 8,
  "name": "Streets with Bathymetry",
  "sprite": "mapbox://sprites/mapbox/streets-v12",
  "glyphs": "mapbox://fonts/mapbox/{fontstack}/{range}.pbf",
  "sources": {
    "composite": {
      "url": "mapbox://mapbox.mapbox-streets-v8,mapbox.mapbox-terrain-v2,mapbox.mapbox-bathymetry-v2",
      "type": "vector"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f8f4f0"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "composite",
      "source-layer": "landcover",
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          "wood",
          "#d4e4c4",
          "grass",
          "#dce8d0",
          "scrub",
          "#e0e8d4",
          "crop",
          "#e4ecd8",
          "snow",
          "#f8f8f8",
          "#dce8d0"
        ],
        "fill-opacity": 0.6
      }
    },
    {
      "id": "national-park",
      "type": "fill",
      "source": "composite",
      "source-layer": "landuse_overlay",
      "filter": ["==", ["get", "class"], "national_park"],
      "paint": {
        "fill-color": "#d2edae",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "composite",
      "source-layer": "landuse",
      "filter": [
        "match",
        ["get", "class"],
        ["park", "airport", "cemetery", "glacier", "hospital", "pitch", "sand", "school"],
        true,
        false
      ],
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          "park",
          "#d2edae",
          "airport",
          "#e8e8e8",
          "cemetery",
          "#d2e0ca",
          "hospital",
          "#f8e8e8",
          "pitch",
          "#c4e0c0",
          "sand",
          "#f0e8d8",
          "school",
          "#f0e8f0",
          "#e8e8e8"
        ],
        "fill-opacity": 0.5
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "composite",
      "source-layer": "water",
      "paint": {
        "fill-color": "#a0d0e0"
      }
    },
    {
      "id": "bathymetry",
      "type": "fill",
      "source": "composite",
      "source-layer": "depth",
      "paint": {
        "fill-color": [
          "interpolate",
          ["linear"],
          ["get", "min_depth"],
          0,
          "#b5e2e8",
          200,
          "#7accd6",
          1000,
          "#5abcc8",
          2000,
          "#3da8bc",
          4000,
          "#2894ae",
          6000,
          "#1a7a94"
        ],
        "fill-opacity": 0.8
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "composite",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#a0d0e0",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 14, 2, 18, 8]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "composite",
      "source-layer": "building",
      "paint": {
        "fill-color": "#e0dcd8",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 14, 0, 15, 0.5, 16, 1]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "filter": [
        "all",
        [
          "match",
          ["get", "class"],
          ["street", "street_limited", "service", "track", "pedestrian", "path"],
          true,
          false
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 10, 0.5, 14, 2, 18, 12]
      }
    },
    {
      "id": "road-major",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "filter": ["match", ["get", "class"], ["primary", "secondary", "tertiary"], true, false],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#f8c86c",
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 6, 0.5, 10, 1, 14, 4, 18, 20]
      }
    },
    {
      "id": "road-motorway-trunk",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "filter": ["match", ["get", "class"], ["motorway", "trunk"], true, false],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#f0a050",
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 4, 0.5, 8, 1, 12, 3, 18, 24]
      }
    },
    {
      "id": "admin-state-province",
      "type": "line",
      "source": "composite",
      "source-layer": "admin",
      "filter": ["all", ["==", ["get", "admin_level"], 1], ["==", ["get", "maritime"], "false"]],
      "paint": {
        "line-color": "#b0b0b0",
        "line-width": 1,
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "admin-country",
      "type": "line",
      "source": "composite",
      "source-layer": "admin",
      "filter": ["all", ["==", ["get", "admin_level"], 0], ["==", ["get", "maritime"], "false"]],
      "paint": {
        "line-color": "#808080",
        "line-width": 1.5
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "composite",
      "source-layer": "road",
      "filter": [
        "match",
        ["get", "class"],
        ["motorway", "trunk", "primary", "secondary", "tertiary"],
        true,
        false
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["DIN Pro Medium", "Arial Unicode MS Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 8, 14, 12]
      },
      "paint": {
        "text-color": "#666666",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "road-shield",
      "type": "symbol",
      "source": "composite",
      "source-layer": "road",
      "filter": [
        "all",
        ["has", "ref"],
        [
          "match",
          ["get", "class"],
          ["motorway", "trunk", "primary", "secondary", "tertiary"],
          true,
          false
        ]
      ],
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 500,
        "text-field": ["get", "ref"],
        "text-font": ["DIN Pro Bold", "Arial Unicode MS Bold"],
        "text-size": 9,
        "text-rotation-alignment": "viewport",
        "icon-image": [
          "concat",
          ["coalesce", ["get", "shield"], "default"],
          "-",
          ["to-string", ["length", ["get", "ref"]]]
        ],
        "icon-rotation-alignment": "viewport"
      },
      "paint": {
        "text-color": "#333333"
      }
    },
    {
      "id": "poi-label-park",
      "type": "symbol",
      "source": "composite",
      "source-layer": "poi_label",
      "filter": ["match", ["get", "class"], ["park", "park_like"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["DIN Pro Medium", "Arial Unicode MS Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 10, 14, 12],
        "icon-image": ["concat", ["get", "maki"], "-11"],
        "icon-size": 1,
        "text-offset": [0, 0.8],
        "text-anchor": "top"
      },
      "paint": {
        "text-color": "#3a7d44",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "place-label-town",
      "type": "symbol",
      "source": "composite",
      "source-layer": "place_label",
      "filter": ["match", ["get", "type"], ["town", "village"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["DIN Pro Medium", "Arial Unicode MS Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 10, 12, 14]
      },
      "paint": {
        "text-color": "#444444",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "place-label-city",
      "type": "symbol",
      "source": "composite",
      "source-layer": "place_label",
      "filter": ["==", ["get", "type"], "city"],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["DIN Pro Medium", "Arial Unicode MS Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 12, 10, 20]
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "state-label",
      "type": "symbol",
      "source": "composite",
      "source-layer": "place_label",
      "filter": ["==", ["get", "type"], "state"],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["DIN Pro Regular", "Arial Unicode MS Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 3, 9, 6, 12],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.15
      },
      "paint": {
        "text-color": "#888888",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "country-label",
      "type": "symbol",
      "source": "composite",
      "source-layer": "place_label",
      "filter": ["==", ["get", "type"], "country"],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["DIN Pro Medium", "Arial Unicode MS Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 1, 10, 4, 16, 6, 20]
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    }
  ]
}
