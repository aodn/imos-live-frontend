# Copy this file to `.env` (or `.env.local`) and fill in real values.
# Vite only exposes variables prefixed with `VITE_` to the browser bundle.

# Mapbox GL JS access token. Get one from https://account.mapbox.com/access-tokens/
VITE_MAPBOX_KEY=

# Base URL for the data tile / manifest origin.
# Production should point at the TLS-terminated CloudFront distribution.
# If unset, the app falls back to the raw HTTP origin baked into src/api/tiles.ts.
VITE_TILE_BASE_URL=https://imoslive.edge.aodn.org.au/data_tiles


# Optional: enable the in-app feedback widget.
# VITE_FEEDBACK_ENABLED=true

# Optional: set to "true" inside Playwright/automated test runs so the map
# disables real Mapbox network calls and exposes a window.map handle.
# VITE_AUTOMATED_TEST_RUNNING=

# Optional: Google Analytics measurement ID. Injected into index.html at build
# time by the vite-plugin-google-analytics in vite.config.ts.
# VITE_GA_MEASUREMENT_ID=

# Optional: emit a bundle-stats treemap to dist/stats.html during `pnpm build`.
# VITE_STATS_ENABLED=true

# Optional (debug): read each atlas tile back from the GPU after upload and log
# whether the slot's data is smooth (correct) or scrambled (corrupt) — used to
# diagnose the scalar-overlay "speckle" bug. Heavy (a GPU sync per upload), so
# leave unset outside debugging.
# See src/AtlasRenderingSystem/webgl/atlasUploadDiagnostics.ts
# VITE_ATLAS_DIAG=true
